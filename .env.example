# Copy to .env in the repository root. Existing process environment wins.
# Empty API key disables conversation; no secret is supplied here.
OPENAI_API_KEY=
# Source default; set an identifier available to your provider account.
OPENAI_MODEL=gpt-5.6-luna
STT_DEVICE=auto
STT_RUNTIME=persistent
STT_MODEL=small
# Optional overrides; empty means use the computed default.
STT_MODEL_PATH=
STT_CPU_EXECUTABLE=
STT_CUDA_EXECUTABLE=
STT_LANGUAGE=ja
STT_THREADS=4
STT_BEST_OF=5
STT_BEAM_SIZE=5
STT_QUEUE_CAPACITY=8
TURN_DETECTOR_URL=http://127.0.0.1:8766/predict
TURN_MIN_DELAY=300ms
TURN_MAX_DELAY=2500ms
TURN_MAX_DURATION=120s
INTERRUPTION_DECISION_WINDOW=1500ms
BACKCHANNEL_ACOUSTIC_RECOVERY=true
SPECULATION_ENABLED=true
SPECULATION_TIMEOUT=45s
SPECULATION_COOLDOWN=2s
# Additional exact browser origins, comma-separated. Loopback allowed by default.
API_ALLOWED_ORIGINS=
# CLI only (CLI does not load .env): set this in the shell if desired.
# YUKKURI_ENGINE_URL=http://127.0.0.1:8765
